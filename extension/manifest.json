{
  "manifest_version": 3,
  "name": "HerbiSight",
  "version": "1.1",
  "description": "Hides or dims content labeled as AI on YouTube and Facebook feeds.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{5f4e9706-f39b-4596-95dc-93e990aab38d}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HerbiSight",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["shared.js", "content-youtube.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["shared.js", "content-facebook.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.facebook.com/*"
  ]
}
